# Ejemplo de configuración. Nunca almacenar valores reales en Git.
# El comando rentadrive:production-check valida los parámetros básicos.
APP_NAME=RentaDrive
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://rentadrive.example.com
APP_TIMEZONE=America/Santo_Domingo
APP_LOCALE=es
APP_FALLBACK_LOCALE=es

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=sqlsrv
DB_HOST=
DB_PORT=1433
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=false

SESSION_DRIVER=database
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database

# Para múltiples nodos, usar almacenamiento privado compartido.
FILESYSTEM_DISK=s3
RENTA_EVIDENCE_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=RentaDrive

# Mantener apagado hasta verificar remitente, SMTP y consentimiento.
RENTA_AUTOMATION_ENABLED=false

# Sandbox de pagos NO funciona en producción.
RENTA_PAYMENT_WEBHOOK_SECRET=
